# ==========================================
# edUTT - Biến môi trường mẫu (.env.example)
# Sao chép file này thành .env trước khi chạy
# ==========================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB Replica Set (1-node mặc định từ docker-compose.yml)
MONGO_URI=mongodb://localhost:27017/edutt_db?replicaSet=rs0
MONGO_DB_NAME=edutt_db

# MongoDB Replica Set (3-node nếu dùng docker-compose.cluster.yml)
# MONGO_URI=mongodb://localhost:27017,localhost:27018,localhost:27019/edutt_db?replicaSet=rs0

# JWT Authentication & RBAC
JWT_SECRET=edutt_super_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# CORS (Frontend React Vite URL)
CLIENT_URL=http://localhost:5173
