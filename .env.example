# ==========================================
# edUTT - Biến môi trường mẫu (.env.example)
# Sao chép file này thành .env trước khi chạy
# ==========================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB Replica Set (1-node mặc định từ docker-compose.yml - database: edutt)
MONGO_URI=mongodb://localhost:27017/edutt?replicaSet=rs0
MONGO_DB_NAME=edutt

# MongoDB Replica Set (3-node nếu dùng docker-compose.cluster.yml: 1 Primary, 2 Secondary)
# MONGO_URI=mongodb://localhost:27017,localhost:27018,localhost:27019/edutt?replicaSet=rs0

# Tài khoản kỹ thuật MongoDB (áp dụng sau khi bật auth & phân quyền lớp 2)
# MONGO_APP_URI=mongodb://edutt_app_rw:<password>@localhost:27017/edutt?replicaSet=rs0&authSource=edutt
# MONGO_REPORT_URI=mongodb://edutt_report_ro:<password>@localhost:27017/edutt?replicaSet=rs0&authSource=edutt

# JWT Authentication & RBAC (STUDENT / ADMIN)
JWT_SECRET=edutt_super_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# CORS (Frontend React Vite URL)
CLIENT_URL=http://localhost:5173
